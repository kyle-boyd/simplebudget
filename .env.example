# Use production Firebase Auth & Database when running locally (no emulators).
# Set to 'true' to use the Firebase emulators (Auth on 9099, Database on 9000).
# Default in dev is to use emulators; set to 'false' to test against real Firebase.
VITE_USE_FIREBASE_EMULATORS=false

# Teller (bank sync)
VITE_TELLER_APP_ID=your_teller_app_id
VITE_TELLER_ENVIRONMENT=sandbox
